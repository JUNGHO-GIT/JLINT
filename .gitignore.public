**/.out/
**/target/
**/.target/
**/coverage/
**/.coverage/
**/debug/
**/.debug/
**/temp/
**/.temp/
**/bundle/
**/.bundle/
**/gen/
**/.gen/
**/bin/
**/.bin/

# 2. Dependencies / package artifacts
**/node_modules/
**/vendor/
**/.vendor/

# 3. Framework / tool caches
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.turbo/
**/.vite/
**/.parcel-cache/
**/.nyc_output/
**/.cache/
**/.pnpm-store/
**/.yarn/
**/.pnp/
**/.gradle/

# 4. VCS / misc
**/.git/
**/.direnv/

# 5. Project-private areas
**/admin/
**/private/
**/auth/

# 6. IDE / editor
**/.vscode/
**/.idea/
**/.history/
**/.backup/
**/.bookmark/
**/.tmp/
**/.etc/
**/.grunt/
**/.gulp/

# 7. Java / runtime artifacts
**/META-INF/
**/.META-INF/
**/hs_err_pid*/
**/replay_pid*/

# Files --------------------------------------------------------------------------------------=

# 1. OS / editor noise
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# 2. Logs
**/*.log
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log
**/pnpm-debug.log
**/lerna-debug.log

# 3. Secrets / env / credentials
**/env.*
**/*env.*
**/*.env
**/*.env.*
**/.envrc
**/*.properties
**/*.properties.*
**/*.props
**/*.props.*
**/app.json
**/app.json.*
**/*.keystore
**/*.keystore.*
**/*.jks
**/*.jks.*
**/*.p12
**/*.p12.*
**/*.pem
**/*.pem.*
**/*.key
**/*.key.*

# 4. Java/IDE project files
**/.classpath
**/.classpath.*
**/.project
**/.project.*
**/.settings/
**/*.iml
**/*.ipr
**/*.iws

# 5. Temporary / patch files
**/*.tmp
**/*.tmp.*
**/*.bak
**/*.bak.*
**/*.backup
**/*.backup.*
**/*.orig
**/*.orig.*
**/*.rej
**/*.rej.*
**/*.pid
**/*.pid.*

# 6. Lock files (common)
**/package-lock.json
**/package-lock.json.*
**/npm-shrinkwrap.json
**/npm-shrinkwrap.json.*
**/yarn.lock
**/yarn.lock.*
**/pnpm-lock.yaml
**/pnpm-lock.yaml.*
**/bun.lockb
**/bun.lockb.*
**/bun.lock
**/bun.lock.*

# 7. etc
**/ecosystem.config.js
**/ecosystem.config.*