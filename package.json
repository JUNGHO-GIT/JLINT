{
  "name": "jlint",
  "displayName": "Jlint",
  "description": "Universal Language formatter",
  "publisher": "JUNGHO",
  "license": "Apache-2.0",
  "version": "3.1.8",
  "main": "./out/extension.js",
  "icon": "logo.webp",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNGHO-GIT/JLINT.git"
  },
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages",
    "Snippets",
    "Language Packs",
    "Extension Packs",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "lint",
    "formatter",
    "jlint",
    "code",
    "format",
    "prettier",
    "java",
    "xml",
    "html",
    "css",
    "javascript",
    "typescript",
    "json",
    "yaml",
    "sql",
    "jsp",
    "universal"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "outputChannels": [
      "Jlint"
    ],
    "commands": [
      {
        "command": "extension.Jlint",
        "title": "Jlint"
      },
      {
        "command": "extension.JlintRemoveComments",
        "title": "Jlint: Remove Comments"
      }
    ],
    "keybindings": [
      {
        "command": "extension.Jlint",
        "key": "alt+shift+f",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.Jlint",
          "when": "editorTextFocus"
        },
        {
          "command": "extension.JlintRemoveComments",
          "when": "editorTextFocus"
        }
      ],
      "editor/context": [
        {
          "command": "extension.JlintRemoveComments",
          "when": "editorTextFocus"
        }
      ]
    },
    "configuration": {
      "title": "Jlint",
      "properties": {
        "Jlint.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "Jlint.activateLint": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the lint",
          "scope": "resource"
        },
        "Jlint.removeComments": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the remove comments",
          "scope": "resource"
        },
        "Jlint.insertLine": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable the insert 'vertical line'",
          "scope": "resource"
        },
        "Jlint.quoteType": {
          "type": "string",
          "enum": [
            "single",
            "double"
          ],
          "default": "double",
          "description": "Set the quote type for strings (single: ', double: \")",
          "scope": "resource"
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.109.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "git": "bun ~/.bootstrap/bootstrap-sync.mjs --git",
    "sync": "bun ~/.bootstrap/bootstrap-sync.mjs --sync",
    "tools": "bun ~/.bootstrap/bootstrap-sync.mjs --tools"
  },
  "dependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "clean-css": "5.3.3",
    "html-minifier-terser": "7.2.0",
    "prettier": "3.8.3",
    "prettier-plugin-java": "2.8.1",
    "prettier-plugin-jsp": "1.0.13",
    "sql-formatter": "15.7.3",
    "strip-comments": "2.0.1",
    "strip-json-comments": "5.0.3",
    "terser": "5.46.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.26",
    "@swc/helpers": "0.5.21",
    "@types/clean-css": "4.2.11",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/eslint__js": "9.14.0",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "25.6.0",
    "@types/strip-comments": "2.0.4",
    "@types/vscode": "1.116.0",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vscode/vsce": "3.9.1",
    "esbuild": "0.28.0",
    "eslint": "10.2.1",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.5.0",
    "ts-morph": "28.0.0",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  }
}
