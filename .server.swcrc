/**
 * @file .server.swcrc
 * @description swc 설정 (서버)
 * @author Jungho
 * @since 2025-11-30
 * @updated 2026-02-08
 */
{
  "$schema": "https://swc.rs/schema.json",
  "isModule": true,
  "minify": false, // 서버 – 디버깅/스택 트레이스 가독성 우선
  "sourceMaps": true, // 런타임 에러 디버깅 필수 (--enable-source-maps)
  "inlineSourcesContent": true, // 소스맵에 원본 포함 – 배포 환경에서도 원본 추적 가능
  "exclude": [
    "node_modules"
  ],
  "module": {
    "type": "commonjs", // Node.js/NestJS 표준 모듈 시스템
    "strict": true,
    "strictMode": true,
    "lazy": true, // 의존성 지연 로딩 – 콜드 스타트 시간 단축
    "noInterop": false,
    "importInterop": "swc",
    "ignoreDynamic": false,
    "preserveImportMeta": false,
    "resolveFully": false
  },
  "jsc": {
    "baseUrl": "./",
    "target": "es2022", // Node.js 18+ 안정 지원
    "loose": true,
    "externalHelpers": true, // @swc/helpers 외부화 – 모듈 간 헬퍼 코드 중복 제거
    "keepClassNames": true, // NestJS DI, TypeORM 엔티티, 에러 로그 클래스명 보존
    "preserveAllComments": false,
    "paths": {},
    "parser": {
      "syntax": "typescript",
      "tsx": false, // 서버 기본 – SSR 필요 시 true
      "decorators": true, // NestJS @Controller, @Injectable 등
      "dynamicImport": true
    },
    // [참고] root "minify": false 일 때 jsc.minify 블록은 적용되지 않음
    // 프로덕션 서버 빌드 시 minify: true 로 전환하면 아래 설정이 활성화됨
    "minify": {
      "compress": {
        "dead_code": true,
        "drop_console": false, // 서버 로그 보존
        "drop_debugger": true,
        "unused": true
      },
      "mangle": {
        "keep_classnames": true, // DI 컨테이너 / ORM 리플렉션 보호
        "keep_fnames": true // 스택 트레이스 가독성 보존
      },
      "format": {
        "comments": "all" // 서버 코드 주석 보존 (JSDoc, TODO 등)
      }
    },
    "transform": {
      "legacyDecorator": true, // NestJS / TypeORM 레거시 데코레이터
      "decoratorMetadata": true, // reflect-metadata 기반 DI 필수
      "useDefineForClassFields": false, // legacyDecorator 와 호환 – 할당 방식 유지
      "treatConstEnumAsEnum": false,
      "verbatimModuleSyntax": false,
      "react": {
        "runtime": "automatic",
        "useBuiltins": true,
        "refresh": false // 프로덕션 서버 – 반드시 false
      }
    },
    "output": {
      "charset": "utf8"
    }
  }
}
